# Copy this file to .env. Existing process environment variables take precedence.
# Keep an existing .env; append missing settings instead of replacing its secrets.
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=replace-with-your-model-name

# Required in database mode. Use a SELECT-only account.
MEDIA_CRAWLER_DB_HOST=127.0.0.1
MEDIA_CRAWLER_DB_PORT=3306
MEDIA_CRAWLER_DB_USER=sentiment_reader
MEDIA_CRAWLER_DB_PASSWORD=replace-with-your-database-password

# Required for non-loopback listening. Never use these placeholders as real tokens.
# PUBLIC_SENTIMENT_ADMIN_TOKEN=replace-with-a-strong-admin-token
# PUBLIC_SENTIMENT_OPERATOR_TOKEN=replace-with-a-strong-operator-token
# PUBLIC_SENTIMENT_VIEWER_TOKEN=replace-with-a-strong-viewer-token
# PUBLIC_SENTIMENT_DATA_DIR=E:/learn/public-sentiment
# PUBLIC_SENTIMENT_HOST=127.0.0.1
# PUBLIC_SENTIMENT_PORT=8000
